        },
        "showUnfilled": true,
        "sizing": "auto",
        "textMode": "auto",
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#73BF69"
              },
              {
                "value": 75,
                "color": "#FADE2A"
              },
              {
                "value": 85,
                "color": "#FF9830"
              },
              {
                "value": 95,
                "color": "#F2495C"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "max"
              },
              {
                "id": "color",
                "value": {

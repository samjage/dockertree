          },
          "noValue": "–"
        },
        "overrides": []
      },
      "pluginVersion": "13.2.0"
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Docker Net Usage",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {

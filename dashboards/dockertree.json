    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Top 6 containers (load, % of server)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sort_desc(topk(6, sum by (name, stack)(label_replace(rate(container_cpu_usage_seconds_total{name!=\"\"}[2m]),\"stack\",\"$1\",\"container_label_com_docker_compose_project\",\"(.+)\"))*100 / scalar(count(count by (cpu)(node_cpu_seconds_total)))))",
          "instant": true,
          "legendFormat": "{{name}}",
          "range": false
        }
      ],
      "options": {
        "displayMode": "lcd",
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "left",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto",
        "textMode": "auto",
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 50,

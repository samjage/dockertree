    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "13.2.0"
    },
    {
      "type": "panel",
      "id": "samjage-dockertree-panel",
      "name": "DockerTree",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "Bar gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",

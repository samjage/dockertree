    {
      "id": 10,
      "type": "table",
      "title": "Restarts & Out-of-Memory kills (last 24h)",
      "description": "Containers that (re)started more than 10 minutes after the server booted, or were killed for running out of memory. Newest first. Empty = nothing went wrong.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 9,
        "y": 6,
        "w": 15,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count by (name)(last_over_time(container_start_time_seconds{name!=\"\"}[24h]) > scalar(node_boot_time_seconds) + 600)",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (name)(increase(container_oom_events_total{name!=\"\"}[24h])) > 0",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(time() - max by (name)(container_start_time_seconds{name!=\"\"})) and on(name) count by (name)(last_over_time(container_start_time_seconds{name!=\"\"}[24h]) > scalar(node_boot_time_seconds) + 600)",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false
        }
      ],
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [],
        "zebraStriping": false
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 80,
                "color": "red"
              }
            ]
          },
          "noValue": "–",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "footer": {
              "reducers": []
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Restarts / new (24h)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
